# deploy/scripts/deploy-frontend.sh 和 backup-db.sh 读的部署参数。复制到 deploy/aws.env（git 忽略）。

AWS_REGION=us-east-1
# 本机 aws cli 的 profile（aws configure --profile idle-game）
AWS_PROFILE=idle-game

# 前端静态站
FRONTEND_BUCKET=play-example-com
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC

# SQLite 备份桶（服务器上的备份脚本用实例角色写，不用 profile）
BACKUP_BUCKET=idle-game-backups
