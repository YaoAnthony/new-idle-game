# 前端构建变量。复制到 Frontend-3D/.env.local（git 忽略）。
# 解析在 Frontend-3D/src/Api/backendUrl.ts：一个开关 + 两个地址，切换只改 VITE_BACKEND_TARGET 一个词。
# 这些值是编译进产物的：换目标要重新 build（npm run build / Electron 打包同理）。

# local = 打本机后端；cloud = 打 AWS 上的后端
VITE_BACKEND_TARGET=local

VITE_BACKEND_URL_LOCAL=http://localhost:3001
VITE_BACKEND_URL_CLOUD=https://api.example.com

# Google 登录（可选）。和后端 GOOGLE_CLIENT_ID 同一个
VITE_GOOGLE_CLIENT_ID=
