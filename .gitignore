# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
build/
# TypeScript 的增量编译缓存。它记的是本机的绝对路径和时间戳，
# 提交上去只会让每个人的 diff 里多一坨噪音，还会互相覆盖
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS/editor files
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

production/session-logs/

# 曲库注册表：由 predev/prebuild 从本机 public/music 里的 mp3 现扫现生成
# （scripts/generate-music-registry.mjs）。每台机器音频文件不一样，生成
# 结果就不一样——跟踪它等于每个人 dev 一次就多一坨 diff，还互相覆盖。
# 新 clone 跑 npm run dev 就会长出来。
Frontend-3D/src/Data/music/generated.ts
