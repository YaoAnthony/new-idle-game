# 后端生产环境变量。复制到服务器 /etc/idle-game/backend.env（systemd 用 EnvironmentFile 读，
# 不需要 Backend/.env）。读取点在 Backend/src/shared/config.ts、server.ts、app.ts。
#
# 生产环境（NODE_ENV=production）下：AUTH_JWT_SECRET 少于 32 字符拒绝启动；CORS_ORIGIN 不配 = 一个跨域都不认。

NODE_ENV=production

# 只监听回环：外面只能经同机的 Caddy 进来。放进容器 / ALB 后面才改 0.0.0.0
HOST=127.0.0.1
PORT=3001

# openssl rand -base64 48
AUTH_JWT_SECRET=

# 前端的完整来源，逐字匹配（协议 + 域名 + 端口），多个用逗号。不要尾斜杠
CORS_ORIGIN=https://play.example.com

# 在 Caddy 后面：只信最近一跳的 X-Forwarded-For，登录限流才按真实 IP 分桶
TRUST_PROXY=1

# 放在部署目录外面，重新拉代码不会碰到它；备份脚本也读这个路径
DB_PATH=/var/lib/idle-game/app.db

# 可选。要和前端 VITE_GOOGLE_CLIENT_ID 同一个，Google 控制台「已授权的 JavaScript 来源」加上 CORS_ORIGIN 那个域名
GOOGLE_CLIENT_ID=
