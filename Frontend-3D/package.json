{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/generate-music-registry.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-music-registry.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron electron/main.cjs\"",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:build": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@paypal/react-paypal-js": "^8.9.2",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/themes": "^3.3.0",
    "@react-oauth/google": "^0.12.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@xyflow/react": "^12.11.2",
    "antd": "^5.29.3",
    "axios": "^1.18.1",
    "elkjs": "^0.11.1",
    "github-markdown-css": "^5.9.0",
    "google-auth-library": "^10.9.0",
    "i18next": "^26.3.6",
    "idb": "^8.0.3",
    "jsonwebtoken": "^9.0.3",
    "motion": "^11.18.2",
    "phaser": "^3.90.0",
    "phaser-raycaster": "^0.10.11",
    "postprocessing": "^6.39.4",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-fast-marquee": "^1.6.5",
    "react-i18next": "^17.0.9",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-pageflip": "^2.0.3",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "react-router-hash-link": "^2.4.3",
    "react-syntax-highlighter": "^16.1.1",
    "react-type-animation": "^3.2.0",
    "recharts": "^2.15.4",
    "redux-persist": "^6.0.0",
    "redux-persist-transform-filter": "^0.0.22",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3",
    "tailwind-scrollbar-hide": "^2.0.0",
    "three": "^0.171.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.newidlegame.desktop",
    "productName": "NewIdleGame",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
